{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "portuguese",
  "model": "opus",
  "effortLevel": "medium",
  "cleanupPeriodDays": 180,
  "autoCompactWindow": 200000,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git --version)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm -v)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<HOME>/.claude/hooks/compact-clickup-resume.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<HOME>/.claude/hooks/git-behind-check.py\"",
            "timeout": 30,
            "statusMessage": "Conferindo se o repo está em dia com o remoto..."
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Read|Grep|Glob|NotebookEdit|Agent|Task|mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<HOME>/.claude/hooks/delegate-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<HOME>/.claude/hooks/delegate-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<HOME>/.claude/hooks/session-close-check.py\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
